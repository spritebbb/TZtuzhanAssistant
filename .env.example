# 复制此文件为 .env 并填写真实值

# ---- LLM（任意 OpenAI 兼容端点）----
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-这里填你的key
LLM_MODEL=deepseek-chat
# LLM_MODEL_STRONG=deepseek-reasoner   # 强模型路由（D5）：写作/代码/长文类请求改走此模型；留空=全部走主模型
# LLM_PRICE_INPUT_PER_MTOK=1.0         # 成本面板价格（元/百万 tokens），按你的服务商实际价格填
# LLM_PRICE_OUTPUT_PER_MTOK=2.0
LLM_TEMPERATURE=0.8
LLM_MAX_TOKENS=500
# LLM_TIMEOUT=45                   # 主 LLM 单次超时（秒，默认 45）；网络不稳可调小到 30，长回复需调大

# ---- 感知层独立小模型（语义感知，每条消息调用一次，高频轻量）----
# 用它专属的轻量模型/端点可显著降延迟与成本；留空则复用上面的主 LLM。
# key 回退顺序：LLM_PERCEPTION_API_KEY → 同端点 IMAGE_API_KEY（硅基流动常见同 key）
# → 主 LLM_API_KEY。
# 例：硅基流动的轻量模型
# LLM_PERCEPTION_MODEL=Qwen/Qwen3-8B
# LLM_PERCEPTION_BASE_URL=https://api.siliconflow.cn/v1
# LLM_PERCEPTION_API_KEY=sk-你的key
# LLM_PERCEPTION_TIMEOUT=30          # 感知层单次超时（秒，默认 30；小模型冷启动较慢）

# ---- 人格文件（项目内，已纳入 git 管理）----
PERSONA_FILE=persona-菟菚.md

# ---- 联网搜索（博查 API 最稳定；SEARCH_ENABLED=0 关闭；SEARCH_ENGINE=bing/ddg 自动回退）----
SEARCH_ENABLED=1
SEARCH_ENGINE=bing
SEARCH_API_KEY=sk-这里填博查的key（可选，填了优先用博查）

# ---- 图像生成（SiliconFlow 文生图；IMAGE_API_KEY 留空则生图关闭）----
# IMAGE_BASE_URL=https://api.siliconflow.cn/v1
# IMAGE_API_KEY=sk-你的siliconflow-key
# IMAGE_MODEL=Qwen/Qwen-Image

# ---- 菟菚自制表情包（复用上面的生图配置；低频自动附带并收藏）----
# STICKER_ENABLED=1
# STICKER_CHANCE_PERCENT=10  # 命中情绪场景后的基础概率；初识/熟悉阶段会进一步降低
# STICKER_MIN_MESSAGE_GAP=10 # 两次贴纸至少间隔的 userdb 消息数（约 5 轮对话）
# STICKER_COLLECTION_MAX=24  # 收藏上限；达到后只复用、不继续生成

# ---- 图片理解（识图；VISION_* 不填则复用上面的 IMAGE_* key）----
# 例：硅基流动 Qwen2.5-VL
# VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
# 例：通义千问 VL（DashScope 兼容端点）
# VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VISION_API_KEY=sk-你的dashscope-key
# VISION_MODEL=qwen-vl-max

# ---- 心情系统（MOOD_CITY 填城市如"北京"，心情随当日天气波动；留空则按时间段兜底）----
# MOOD_CITY=北京

# ---- 数据目录（留空默认使用项目根 data/；测试、容器或独立实例可改到其他目录）----
# TZTUZHAN_DATA_DIR=data

# ---- 主动消息（问候 + initiative 共用每日额度）----
# PROACTIVE_GREETING_IDLE_HOURS=8   # 打开页面时，距上次访问多久才主动问候
# PROACTIVE_IDLE_HOURS=6            # 后台主动引擎距上次聊天多久才进入候选
# PROACTIVE_DAILY_MAX=1             # 每用户每天主动消息总上限（两个通道合计）
# PROACTIVE_GLOBAL_COOLDOWN_SEC=900 # 后台主动检查的全局冷却
# PROACTIVE_CHECK_INTERVAL_SEC=300  # 后台主动检查间隔
# PROACTIVE_FAILURE_COOLDOWN_SEC=900 # 生成/投递失败后的重试冷却，避免失败风暴
# PROACTIVE_IMAGE_ENABLED=1          # 生图服务可用时，允许亲密/恋人阶段偶尔主动发图
# PROACTIVE_IMAGE_CHANCE_PERCENT=20  # 满足状态条件后的基础触发概率（久别恋人会翻倍）
# PROACTIVE_IMAGE_MIN_MOOD=70        # 主动发图所需最低心情值

# ---- 记忆 embedding 模型下载镜像 ----
# 本地语义记忆首次启动会下载 BGE embedding 模型（默认 BAAI/bge-m3，约 1.2GB）。
# 国内直连 huggingface.co 常超时（WinError 10060），默认走 hf-mirror.com 镜像；
# 有代理/海外环境可设 HF_ENDPOINT=https://huggingface.co 改回官方源。
HF_ENDPOINT=https://hf-mirror.com
# 也可换成更小的中文模型（约 100MB，下载快、中文检索效果也不错）：
# MEMORY_EMBED_MODEL=BAAI/bge-small-zh-v1.5

# ---- 受控端点鉴权（/api/remote、/mcp/*、/api/mcp/*、/api/agent/*、/api/* 写端点、/plugins/*）----
# AGENT_REMOTE_TOKEN=你的token        # 非回环来源（局域网/公网设备）调用必须带此 token；
                                     # 本机回环来源始终免 token（来源 IP 语义，与绑定地址无关）
# AGENT_REMOTE_ALLOW_EMPTY_TOKEN=1    # 历史开关：来源 IP 语义下不再影响判定，仅保留兼容
# AGENT_ALLOWED_HOSTS=127.0.0.1:8801;localhost:8801   # Host 白名单；--host 0.0.0.0 局域网访问时追加本机局域网地址

# ---- 外部 Agent 桥：菟菚 → Codex（codex_run 工具，非交互 exec 模式）----
# AGENT_CODEX_PATH=                 # Codex CLI 路径（留空自动探测 %LOCALAPPDATA%\OpenAI\Codex\bin 下最新版）
# AGENT_CODEX_PROFILE=deepseek      # 使用的 Codex profile（~/.codex/<name>.config.toml）
# AGENT_CODEX_CWD=D:\DSH\TZtuzhanAssistant  # Codex 工作目录（默认项目根）
# AGENT_CODEX_TIMEOUT=180           # 单次任务超时（秒）
# DEEPSEEK_API_KEY=                 # deepseek profile 需要的 key；不填时若主 LLM 是 DeepSeek，自动复用 LLM_API_KEY

# ---- 外部 Agent 桥：菟菚 → DSH（dsh_run 工具）----
# AGENT_DSH_TIMEOUT=120             # 单次任务超时（秒，默认 120）

# ---- 备选提供方（切换时：注释掉上面的 base_url/model 对应行，取消注释下面一组）----
# 硅基流动 SiliconFlow：https://api.siliconflow.cn/v1（模型如 Qwen/Qwen3-32B、deepseek-ai/DeepSeek-V3）
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=Qwen/Qwen3-32B
# 通义千问 DashScope：https://dashscope.aliyuncs.com/compatible-mode/v1（模型如 qwen-plus）
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# OpenAI：https://api.openai.com/v1（模型如 gpt-4o-mini）
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
