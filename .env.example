# 复制此文件为 .env 并填写真实值

# ---- LLM（任意 OpenAI 兼容端点）----
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-这里填你的key
LLM_MODEL=deepseek-chat
# LLM_MODEL_STRONG=deepseek-reasoner   # 强模型路由（D5）：写作/代码/长文类请求改走此模型；留空=全部走主模型
# LLM_PRICE_INPUT_PER_MTOK=1.0         # 成本面板价格（元/百万 tokens），按你的服务商实际价格填
# LLM_PRICE_OUTPUT_PER_MTOK=2.0
LLM_TEMPERATURE=0.8
LLM_MAX_TOKENS=500
# LLM_TIMEOUT=45                   # 主 LLM 单次超时（秒，默认 45）；网络不稳可调小到 30，长回复需调大

# ---- 感知层独立小模型（语义感知，每条消息调用一次，高频轻量）----
# 用它专属的轻量模型/端点可显著降延迟与成本；留空则复用上面的主 LLM。
# key 回退顺序：LLM_PERCEPTION_API_KEY → 同端点 IMAGE_API_KEY（硅基流动常见同 key）
# → 主 LLM_API_KEY。
# 例：硅基流动的轻量模型
# LLM_PERCEPTION_MODEL=Qwen/Qwen3-8B
# LLM_PERCEPTION_BASE_URL=https://api.siliconflow.cn/v1
# LLM_PERCEPTION_API_KEY=sk-你的key
# LLM_PERCEPTION_TIMEOUT=30          # 感知层单次超时（秒，默认 30；小模型冷启动较慢）

# ---- 人格文件（项目内，已纳入 git 管理）----
PERSONA_FILE=persona-菟菚.md

# ---- 联网搜索（P0-04 C2 双轨：博查管中文查询、Tavily 管非中文查询，互为回退）----
# 只填一把也能用；SEARCH_ENGINE=bing/ddg 是两轨都失败后的免 key 兜底
SEARCH_ENABLED=1
SEARCH_ENGINE=bing
SEARCH_API_KEY=sk-这里填博查的key（可选，填了中文查询优先用博查）
TAVILY_API_KEY=tvly-这里填Tavily的key（可选，填了非中文查询优先用Tavily）

# ---- 图像生成（SiliconFlow 文生图；IMAGE_API_KEY 留空则生图关闭）----
# IMAGE_BASE_URL=https://api.siliconflow.cn/v1
# IMAGE_API_KEY=sk-你的siliconflow-key
# IMAGE_MODEL=Qwen/Qwen-Image

# ---- 菟菚自制表情包（复用上面的生图配置；低频自动附带并收藏）----
# STICKER_ENABLED=1
# STICKER_CHANCE_PERCENT=10  # 命中情绪场景后的基础概率；初识/熟悉阶段会进一步降低
# STICKER_MIN_MESSAGE_GAP=10 # 两次贴纸至少间隔的 userdb 消息数（约 5 轮对话）
# STICKER_COLLECTION_MAX=24  # 收藏上限；达到后只复用、不继续生成

# ---- 知识库（投喂 pdf/txt/md，菟菚"读过"并在对话中自然引用）----
# KB_ENABLED=1
# KB_CHUNK_SIZE=600        # 分块大小（字符）
# KB_CHUNK_OVERLAP=120     # 相邻块重叠字符数（防切断语义）
# KB_RECALL_TOP_K=3        # 每轮最多注入的相关段落数
# KB_RECALL_MAX_DISTANCE=0.55  # cosine 距离阈值，小于才注入（调大更宽松）
# KB_MAX_FILE_MB=20        # 单文件大小上限
# KB_MAX_DOCUMENTS=50      # 单用户文档数上限

# ---- 好感度玩法闭环（C4 解锁时刻）----
# UNLOCK_STREAK_DAYS=7     # 连续陪伴多少天触发「连续陪伴」彩蛋

# ---- 专注陪伴（M3.2：25/50 分钟安静模式）----
# FOCUS_ENABLED=1          # 0 关闭专注模式（开始接口与复盘消息停用）

# ---- 图片理解（识图；VISION_* 不填则复用上面的 IMAGE_* key）----
# 例：硅基流动 Qwen2.5-VL
# VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
# 例：通义千问 VL（DashScope 兼容端点）
# VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VISION_API_KEY=sk-你的dashscope-key
# VISION_MODEL=qwen-vl-max

# ---- 心情系统（MOOD_CITY 填城市如"北京"，心情随当日天气波动；留空则按时间段兜底）----
# MOOD_CITY=北京

# ---- 数据目录（留空默认使用项目根 data/；测试、容器或独立实例可改到其他目录）----
# TZTUZHAN_DATA_DIR=data

# ---- 主动消息（问候 + initiative 共用每日额度）----
# PROACTIVE_GREETING_IDLE_HOURS=8   # 打开页面时，距上次访问多久才主动问候
# PROACTIVE_IDLE_HOURS=6            # 后台主动引擎距上次聊天多久才进入候选
# PROACTIVE_NEW_USER_DAYS=3          # 首次发言后多少天采用新用户主动阈值
# PROACTIVE_NEW_USER_IDLE_HOURS=2    # 新用户适应期内，距上次聊天多久进入候选（初识阶段仍不主动）
# PROACTIVE_DAILY_MAX=1             # 每用户每天主动消息总上限（两个通道合计）
# PROACTIVE_GLOBAL_COOLDOWN_SEC=900 # 后台主动检查的全局冷却
# PROACTIVE_CHECK_INTERVAL_SEC=300  # 后台主动检查间隔
# PROACTIVE_FAILURE_COOLDOWN_SEC=900 # 生成/投递失败后的重试冷却，避免失败风暴
# PROACTIVE_IMAGE_ENABLED=1          # 生图服务可用时，允许亲密/恋人阶段偶尔主动发图
# PROACTIVE_IMAGE_CHANCE_PERCENT=20  # 满足状态条件后的基础触发概率（久别恋人会翻倍）
# PROACTIVE_IMAGE_MIN_MOOD=50        # 主动发图所需最低心情值（亲密/恋人阶段以上才可能触发）
# PROACTIVE_SURPRISE_ENABLED=1        # M5 惊喜编排开关：隔一阵子基于真实共同产物送个小惊喜
# PROACTIVE_SURPRISE_MIN_GAP_DAYS=7   # 两次惊喜的最小间隔天数
# PROACTIVE_SURPRISE_CHANCE_PERCENT=50 # 到点后每次检查的触发概率
# PROACTIVE_SURPRISE_IDLE_MINUTES=120 # 距上次聊天多久才允许惊喜出牌

# FEATURE_TELEMETRY_ENABLED=1        # 本地最小诊断统计；0=停止新记录
# TELEMETRY_EVENT_RETENTION_DAYS=7  # 无正文事件链保留天数（1-30）
# TELEMETRY_RETENTION_DAYS=30        # 日聚合保留天数（1-365）

# ---- 未来信件（M8：写给未来的我们）----
# FUTURE_LETTERS_ENABLED=1          # 0 关闭未来信件（列表/写信/拆信/删除接口停用）

# ---- 关系快照（M8：30/100/365 天纪念页）----
# RELATIONSHIP_SNAPSHOTS_ENABLED=1   # 0 关闭关系快照（列表/创建/删除接口停用）

# ---- 双视角叙事（M8：同一经历的双方解释页）----
# DUAL_PERSPECTIVES_ENABLED=1        # 0 关闭双视角（列表/创建/视角/草稿/删除接口停用）

# ---- 梦境 / 平行可能性（M8：显式收藏的虚构片段）----
# POSSIBILITIES_ENABLED=1            # 0 关闭（生成草稿/收藏/删除接口停用）

# ---- 不同版本的我们（M8.7：关系版本检查点）----
# RELATIONSHIP_VERSIONS_ENABLED=1    # 0 关闭（列表/创建/比较/删除接口停用）

# ---- 记忆 embedding 模型下载镜像 ----
# 本地语义记忆首次启动会下载 BGE embedding 模型（默认 BAAI/bge-m3，约 1.2GB）。
# V2 当前默认开启；设为 0 可明确退回纯 SQLite/词面检索。
MEMORY_V2=1
# 国内直连 huggingface.co 常超时（WinError 10060），默认走 hf-mirror.com 镜像；
# 有代理/海外环境可设 HF_ENDPOINT=https://huggingface.co 改回官方源。
HF_ENDPOINT=https://hf-mirror.com
# 也可换成更小的中文模型（约 100MB，下载快、中文检索效果也不错）：
# MEMORY_EMBED_MODEL=BAAI/bge-small-zh-v1.5

# ---- 受控端点鉴权（/api/remote、/mcp/*、/api/mcp/*、/api/agent/*、/api/* 写端点、/plugins/*）----
# AGENT_REMOTE_TOKEN=你的token        # 非回环来源（局域网/公网设备）调用必须带此 token；
                                     # 本机回环来源始终免 token（来源 IP 语义，与绑定地址无关）
# AGENT_REMOTE_ALLOW_EMPTY_TOKEN=1    # 历史开关：来源 IP 语义下不再影响判定，仅保留兼容
# AGENT_ALLOWED_HOSTS=127.0.0.1:8801;localhost:8801   # Host 白名单；--host 0.0.0.0 局域网访问时追加本机局域网地址

# ---- 外部 Agent 桥：菟菚 → Codex（codex_run 工具，非交互 exec 模式）----
# AGENT_CODEX_PATH=                 # Codex CLI 路径（留空自动探测 %LOCALAPPDATA%\OpenAI\Codex\bin 下最新版）
# AGENT_CODEX_PROFILE=deepseek      # 使用的 Codex profile（~/.codex/<name>.config.toml）
# AGENT_CODEX_CWD=D:\DSH\TZtuzhanAssistant  # Codex 工作目录（默认项目根）
# AGENT_CODEX_TIMEOUT=180           # 单次任务超时（秒）
# DEEPSEEK_API_KEY=                 # deepseek profile 需要的 key；不填时若主 LLM 是 DeepSeek，自动复用 LLM_API_KEY

# ---- 外部 Agent 桥：菟菚 → DSH（dsh_run 工具）----
# AGENT_DSH_TIMEOUT=120             # 单次任务超时（秒，默认 120）

# ---- 成本闸门（子代理编排 agent_run / agent_fanout 的失控保护）----
# AGENT_SUBAGENT_CONCURRENCY=3      # 全局同时在飞的子代理 LLM 调用数（跨任务共享信号量）
# AGENT_FANOUT_MAX=5                # 单次 agent_fanout 的任务数上限（超过要求分批）
# AGENT_TASK_TOKEN_BUDGET=120000    # 单个 Agent 任务 token 预算（prompt+completion，实际或估算）；
#                                   # 用尽后工具循环提前收束、子代理拒绝派发，任务以带说明的结果结束
# AGENT_SUBAGENT_MAX_DEPTH=1        # 子代理嵌套深度上限（防未来工具化子代理递归派发）

# ---- L09 本地语音输入（桌面版；骨架已实装，模型需用户显式下载）----
# LOCAL_STT_MODELS_DIR=             # whisper 模型目录（默认 <数据目录>/local_stt_models；目录内按 tiny/base/small 命名）
# LOCAL_STT_FFMPEG=                 # 非 PCM 音频转码用的 ffmpeg（留空用 PATH；骨架阶段转码未实装，仅探测能力）

# ---- D12 主动意愿 roll（值得说的主动消息她还是会想想想不想说；硬规则不受影响）----
# WILLINGNESS_AFFECTION_WEIGHT=0.20  # 好感项权重（intimacy/100 × 此值）
# WILLINGNESS_TENSION_WEIGHT=0.30    # 关系张力压抑项权重
# WILLINGNESS_FOCUS_PENALTY=0.40     # 专注安静模式压抑项
# WILLINGNESS_MISS_COMPENSATE=0.15   # 连续 3 次未中后的想念补偿
# WILLINGNESS_FLOOR=0.05             # 概率下限
# WILLINGNESS_CEIL=0.95              # 概率上限

# ---- D10 叙事化成本熔断（超支不报错：她按日程去忙了；你找她聊天永远照常）----
# COST_MONTHLY_BUDGET_CNY=30.0        # 月预算（¥，按 usage_log 实测估算）
# COST_SOFT_RATIO=0.70                # 软档：≥70% 非紧急主动更挑剔 + 她轻提一句事多（每日一次）
# COST_EXTREME_RATIO=1.30             # 极端档：≥130% 感知/批处理降弱模型 + 回复更简短
# COST_DOWNGRADE_MODEL=               # 极端档降级到的廉价模型名（留空=不降模型，仅停自主活动）

# ---- D11 离线补算（你不在时她照常过日子，回来逐条讲给你；离线够久才触发）----
# OFFLINE_RECAP_MIN_GAP_HOURS=8.0     # 离开多久才算「离线」（小时）
# OFFLINE_RECAP_MAX_DAYS=14           # 补算回看的最大窗口（天，超出只看最近这些天）
# OFFLINE_RECAP_EVENT_CAP=8           # 回放条数上限（超出折叠成一句摘要）

# ---- P3-03 本地语音（GPT-SoVITS；装好服务并登记声纹后，设置页打开「本地语音」）----
# LOCAL_TTS_ENDPOINT=http://127.0.0.1:9880  # 推理服务地址（须带 /capabilities 与 /tts，见 docs/GPT-SOVITS-LOCAL-RUNBOOK.md）
# LOCAL_TTS_TIMEOUT=60                       # 单块合成超时（秒）

# ---- 备选提供方（切换时：注释掉上面的 base_url/model 对应行，取消注释下面一组）----
# 硅基流动 SiliconFlow：https://api.siliconflow.cn/v1（模型如 Qwen/Qwen3-32B、deepseek-ai/DeepSeek-V3）
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=Qwen/Qwen3-32B
# 通义千问 DashScope：https://dashscope.aliyuncs.com/compatible-mode/v1（模型如 qwen-plus）
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
# OpenAI：https://api.openai.com/v1（模型如 gpt-4o-mini）
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
