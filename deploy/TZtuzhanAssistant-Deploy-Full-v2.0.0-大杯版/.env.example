# ============================================================
#  Tuzhan Assistant deployment config template
#  首次启动时脚本会把它复制为 .env；请填写真实 Key 后使用
# ============================================================

# ---- LLM（必填；任意 OpenAI 兼容端点均可）----
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.8
LLM_MAX_TOKENS=500
# LLM_TIMEOUT=45
# LLM_PROXY=off              # 本机有失效代理时设 off 强制直连

# ---- 感知层独立小模型（可选，留空复用主 LLM）----
# LLM_PERCEPTION_MODEL=
# LLM_PERCEPTION_BASE_URL=
# LLM_PERCEPTION_API_KEY=
# LLM_PERCEPTION_TIMEOUT=30

# ---- 人格 ----
PERSONA_FILE=persona-菟菚.md

# ---- 联网搜索（可选；不填 key 也会用 bing/ddg 兜底）----
SEARCH_ENABLED=1
SEARCH_ENGINE=bing
SEARCH_API_KEY=

# ---- 文生图（可选）----
# IMAGE_BASE_URL=https://api.siliconflow.cn/v1
# IMAGE_API_KEY=
# IMAGE_MODEL=Qwen/Qwen-Image

# ---- 识图（可选；不填则尽量复用 IMAGE/LLM 端点）----
# VISION_BASE_URL=
# VISION_API_KEY=
# VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct

# ---- 心情绑定城市天气（可选，留空按时间段兜底）----
# MOOD_CITY=北京

# ---- 记忆 embedding ----
# 全量版默认 BAAI/bge-m3（约 1.2GB，首次启动自动下载，中文语义检索效果最好）；
# 想减小下载体积可改回 BAAI/bge-small-zh-v1.5（约 100MB），或设 MEMORY_EMBED_FORCE=1 走哈希回退。
MEMORY_EMBED_MODEL=BAAI/bge-m3
# MEMORY_EMBED_FORCE=0
HF_ENDPOINT=https://hf-mirror.com
MEMORY_V2=1
MEMORY_MEM0=1
MEMORY_SEMANTIC=1

# ---- 局域网/受控端点鉴权（默认仅本机，无需修改）----
# AGENT_REMOTE_TOKEN=
# AGENT_ALLOWED_HOSTS=127.0.0.1:8801;localhost:8801

# ---- 外部 Agent 桥（可选）----
# AGENT_CODEX_PATH=
# AGENT_CODEX_PROFILE=deepseek
# AGENT_CODEX_CWD=
# AGENT_CODEX_TIMEOUT=180
# AGENT_DSH_TIMEOUT=120

